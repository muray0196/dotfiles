+    // ========================================
+    // Environment reflection keeps the local background hue. Unlike the old
+    // near-white rim, dark saturated colours are not lifted to white or
+    // normalized to full intensity. Bright light is a separate, shaped lobe.
+    vec3 reflectedEnvironment = vec3(1.0);
+    float reflectionLobe = 0.0;
+    bool contourLighting = shapedReflection > 0.001 && integratedLens > 0.001;
+    if (shapedReflection > 0.001 && capDepth < 1.0) {
+        vec3 environment;
+        if (contourLighting) {
+            // A reflected footprint outside the silhouette, with a small
+            // tangential spread. All taps stay within the existing padding.
+            vec2 lipNormal = sdfOutwardNormal(uv);
+            vec2 tangent = vec2(-lipNormal.y, lipNormal.x);
+            vec2 boundaryUV = uv + lipNormal * max(-cornerSdf, 0.0) * invFullSize;
+            float reflectionScale = min(monitorScale, 1.5);
+            float reach = min((6.0 + 12.0 * (1.0 - capNormal.z)) * reflectionScale, 24.0);
+            vec2 reflectedUV = boundaryUV + capOutward * reach * invFullSize;
+            vec2 spreadUV = tangent * (5.0 * reflectionScale) * invFullSize;
+            environment = 0.5 * texture(diffuseTex,
+                clamp(toTexUV(toSampleBoxUV(reflectedUV)), 0.001, 0.999)).rgb;
+            environment += 0.25 * texture(diffuseTex,
+                clamp(toTexUV(toSampleBoxUV(reflectedUV + spreadUV)), 0.001, 0.999)).rgb;
+            environment += 0.25 * texture(diffuseTex,
+                clamp(toTexUV(toSampleBoxUV(reflectedUV - spreadUV)), 0.001, 0.999)).rgb;
+        } else {
+            vec2 environmentUV = uv + capOutward * (8.0 * monitorScale) * invFullSize;
+            environment = texture(diffuseTex,
+                clamp(toTexUV(toSampleBoxUV(environmentUV)), 0.001, 0.999)).rgb;
+        }
+        environment = clamp(environment, 0.0, 1.0);
+        float environmentLum = dot(environment, vec3(0.2126, 0.7152, 0.0722));
+        reflectedEnvironment = mix(vec3(environmentLum), environment, 0.92);
+        if (contourLighting && rolledReturnWeight > 0.001)
+            reflectedEnvironment = mix(reflectedEnvironment, returnedScene, rolledReturnWeight);
+        float alignment = dot(capOutward, lightDir(bevelAngle));
+        reflectionLobe = pow(max(alignment, 0.0), 10.0)
+            + 0.28 * pow(max(-alignment, 0.0), 14.0);
+        if (integratedLens > 0.001) {
+            // A wider virtual light reaches the straight edges as well as the
+            // corners. Keep its footprint in the existing narrow contour core;
+            // this changes angular coverage, not the broad surface sheen.
+            float extendedLobe = pow(max(alignment, 0.0), 4.0)
+                + 0.20 * pow(max(-alignment, 0.0), 6.0);
+            reflectionLobe = mix(reflectionLobe, extendedLobe, integratedLens);
+        }
+    }
+
+    // Broaden the environment's angular footprint across the rolled shoulder.
+    // This is an extended-light envelope, not the dielectric return weight.
+    // Mix scene radiance before the common tone response so a uniform backdrop
+    // cannot acquire a brighter inner band just from the wider reflection.
+    if (contourLighting && fresnelStrength > 0.001) {
+        float grazing = pow(1.0 - capNormal.z, 3.0);
+        float reflection = (0.035 + 0.965 * grazing)
+            * (1.0 - capDepth) * fresnelStrength;
+        vec3 reflectionColor = mix(vec3(1.0), fresnelColor, fresnelColorAlpha);
+        if (fresnelTint > 0.001) {
+            float maxC = max(max(color.r, color.g), color.b);
+            reflectionColor = mix(reflectionColor,
+                maxC > 0.001 ? color / maxC : vec3(1.0), fresnelTint);
+        }
+        reflectionColor = mix(reflectionColor, reflectedEnvironment, shapedReflection);
+        color = mix(color, reflectionColor, clamp(reflection * materialProgress, 0.0, 1.0));
+    }
