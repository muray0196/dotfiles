+// Gradient of the same crease-free rounded contour used for the cap depth.
+// Unlike the rectangular edge-flow field, this turns continuously through corners.
+vec2 curvedOutwardNormal(vec2 uv) {
+    vec2 h = invFullSize;
+    vec2 grad = vec2(
+        getBevelSDF(uv + vec2(h.x, 0.0)) - getBevelSDF(uv - vec2(h.x, 0.0)),
+        getBevelSDF(uv + vec2(0.0, h.y)) - getBevelSDF(uv - vec2(0.0, h.y))
+    );
+    float len = length(grad);
+    return len > 0.0001 ? grad / len : vec2(0.0, -1.0);
+}
