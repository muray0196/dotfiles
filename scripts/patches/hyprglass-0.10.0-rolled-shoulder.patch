-// A finite glass solid with a smooth rolled front and back. Its outline
-// matches the rounded box. The cubic radial cap has zero slope and curvature
-// where it joins the centre, avoiding a visible inner bevel boundary.
-vec3 rolledSurface(vec2 p, float radius, float rise, out float height) {
+// Separate silhouette radius from optical depth: larger controls keep a clear
+// face rather than growing indefinitely into deep lenses. The fifth-order front
+// turns more fully at the lip and settles sooner into the face; the gentler cubic
+// back retains the coloured return. Both meet the flat face with zero slope and
+// curvature. Use the analytic gradient for refraction and highlight normals.
+vec3 rolledSurface(vec2 p, float radius, float width, float rise, bool rear, out float height) {
     vec2 q = max(abs(p) - (0.5 * glassBoxSizePx - radius), 0.0);
-    float u2 = dot(q, q) / (radius * radius);
-    float u = sqrt(u2);
-    float h = sqrt(max(1.0 - u2 * u, 0.000001));
-    height = rise * radius * h;
-    return normalize(vec3(1.5 * rise * u * sign(p) * q, radius * h));
+    float radial = length(q);
+    float u = max(0.0, (radial - radius + width) / width);
+    float u2 = u * u;
+    float power = rear ? u2 * u : u2 * u2 * u;
+    float slope = rear ? 1.5 * rise * u2 : 2.5 * rise * u2 * u2;
+    float h = sqrt(max(1.0 - power, 0.000001));
+    height = rise * width * h;
+    vec2 outward = radial > 0.0001 ? sign(p) * q / radial : vec2(0.0);
+    return normalize(vec3(slope * outward, h));
 }
 
