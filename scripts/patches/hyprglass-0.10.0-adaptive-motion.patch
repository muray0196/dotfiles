@@ -0,0 +1,127 @@
+#include "LayerMaterialMotion.hpp"
+#include "GlassLayerSurface.hpp"
+#include "Globals.hpp"
+#include "LayerGeometry.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <format>
+#include <sstream>
+#include <unordered_map>
+#include <hyprland/src/managers/eventLoop/EventLoopManager.hpp>
+#include <hyprland/src/render/Renderer.hpp>
+extern "C" {
+#include <lauxlib.h>
+#include <lua.h>
+}
+
+namespace LayerMaterialMotion {
+namespace {
+using Clock = std::chrono::steady_clock;
+struct Transition {
+    float from = 1.0f;
+    float target = 1.0f;
+    Clock::time_point started{};
+    float durationMs = 0.0f;
+
+    float value() const {
+        if (durationMs <= 0.0f)
+            return target;
+        const float elapsed = std::chrono::duration<float, std::milli>(Clock::now() - started).count();
+        const float t = std::clamp(elapsed / durationMs, 0.0f, 1.0f);
+        const float eased = t * t * (3.0f - 2.0f * t);
+        return from + (target - from) * eased;
+    }
+    bool active() const {
+        return durationMs > 0.0f && from != target &&
+            std::chrono::duration<float, std::milli>(Clock::now() - started).count() < durationMs;
+    }
+};
+std::unordered_map<std::string, Transition> transitions;
+SP<CEventLoopTimer> timer;
+
+void damage(const std::string& layerNamespace) {
+    if (!g_pGlobalState || !g_pHyprRenderer)
+        return;
+    for (const auto& [key, state] : g_pGlobalState->layerSurfaces) {
+        const auto layer = state->getLayerSurface();
+        if (!layer || layer->m_namespace != layerNamespace)
+            continue;
+        const auto monitor = layer->m_monitor.lock();
+        auto box = LayerGeometry::computePaddedLogicalLayerBox(layer, monitor, GlassRenderer::SAMPLE_PADDING_PX);
+        if (box && monitor) {
+            box->translate(monitor->m_position);
+            g_pHyprRenderer->damageBox(*box);
+        }
+    }
+}
+}
+
+float progress(const std::string& layerNamespace) {
+    const auto it = transitions.find(layerNamespace);
+    return it == transitions.end() ? 1.0f : it->second.value();
+}
+
+static SDispatchResult dispatchVisibility(std::string request) {
+    std::istringstream input(request);
+    std::string name, action, extra;
+    input >> name >> action;
+    if ((name != "quickshell-clock" && name != "quickshell-performance") || (input >> extra) ||
+        (action != "show" && action != "hide" && action != "shown" && action != "hidden"))
+        return {.success = false, .error = "Expected a Quickshell namespace and show/hide/shown/hidden"};
+    const bool show = action == "show" || action == "shown";
+    const bool snap = action == "shown" || action == "hidden";
+    const auto found = transitions.find(name);
+    const float from = found == transitions.end() ? (show ? 0.0f : 1.0f) : found->second.value();
+    transitions[name] = {from, show ? 1.0f : 0.0f, Clock::now(), snap ? 0.0f : (show ? 220.0f : 180.0f)};
+    damage(name);
+    timer->updateTimeout(std::chrono::milliseconds(1));
+    return {};
+}
+
+void init(HANDLE handle) {
+    timer = makeShared<CEventLoopTimer>(std::nullopt,
+        [](SP<CEventLoopTimer> self, void*) {
+            bool active = false;
+            for (auto& [name, transition] : transitions) {
+                if (transition.durationMs <= 0.0f)
+                    continue;
+                damage(name); // Includes the final frame, so zero/one is actually drawn.
+                if (transition.active())
+                    active = true;
+                else {
+                    transition.from = transition.target;
+                    transition.durationMs = 0.0f;
+                }
+            }
+            self->updateTimeout(active ? std::optional<Time::steady_dur>{std::chrono::milliseconds(16)} : std::nullopt);
+        }, nullptr);
+    g_pEventLoopManager->addTimer(timer);
+    HyprlandAPI::addDispatcherV2(handle, "hyprglass:visibility", dispatchVisibility);
+    HyprlandAPI::addLuaFunction(handle, "hyprglass", "visibility", [](lua_State* L) -> int {
+        const char* name = luaL_checkstring(L, 1);
+        const char* action = luaL_checkstring(L, 2);
+        const auto result = dispatchVisibility(std::string(name) + " " + action);
+        if (!result.success)
+            return luaL_error(L, "%s", result.error.c_str());
+        return 0;
+    });
+}
+
+std::string status() {
+    return std::format("{{\"clock\":{:.5f},\"performance\":{:.5f},\"timerArmed\":{}}}\n",
+        progress("quickshell-clock"), progress("quickshell-performance"), timer && timer->armed());
+}
+
+void shutdown(HANDLE handle) {
+    HyprlandAPI::removeLuaFunction(handle, "hyprglass", "visibility");
+    HyprlandAPI::removeDispatcher(handle, "hyprglass:visibility");
+    if (timer) {
+        timer->cancel();
+        if (g_pEventLoopManager)
+            g_pEventLoopManager->removeTimer(timer);
+        timer.reset();
+    }
+    transitions.clear();
+}
+}
