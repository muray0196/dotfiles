abbr ".."="cd .."
abbr "ll"="ls -alF"
abbr "la"="ls -a"
abbr "l"="ls -CF"
abbr "gs"="git status"
abbr "ga"="git add"
abbr "gc"="git commit"
abbr "gp"="git push"
abbr "gpl"="git pull"
abbr "gl"="git log --oneline --graph --all"
abbr "up"="yay -Syu --noconfirm && brew update && brew upgrade && (! command -v hermes >/dev/null 2>&1 || hermes update)"
abbr "wwup"="waywallen-update"
abbr "clean"="yay -Scc --noconfirm && sudo find /var/cache/pacman/pkg -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.part' -delete && sudo find /var/lib/systemd/coredump -mindepth 1 -maxdepth 1 -type f -delete && brew cleanup"
abbr "bku"="sync && sudo umount /mnt/backup"
