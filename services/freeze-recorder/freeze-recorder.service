[Unit]
Description=Persistent desktop logs and system stall diagnostics
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B -u %h/.local/libexec/freeze-recorder.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
Nice=5
CPUQuota=10%
MemoryMax=128M
MemorySwapMax=0
TasksMax=16
LimitCORE=0

[Install]
WantedBy=default.target
